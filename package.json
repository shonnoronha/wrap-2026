{
  "name": "redbus-wrap-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api": "node server/index.mjs",
    "web": "vite",
    "dev": "node server/index.mjs & vite",
    "build": "tsc -b && vite build",
    "start": "npm run build && NODE_ENV=production node server/index.mjs",
    "test:api": "node server/selftest.mjs",
    "build:demo": "VITE_STATIC=1 VITE_BRAND=neutral vite build && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "framer-motion": "11.18.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
