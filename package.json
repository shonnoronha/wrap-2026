{
  "name": "redbus-wrap-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "compose": "node scripts/compose-batch.mjs",
    "gen:contract": "node scripts/gen-row-contract.mjs",
    "docker:build": "npm run build && npm run compose && docker build --platform linux/arm64 -t wrap-2026 .",
    "api": "npm run compose && node --env-file-if-exists=.env server/index.mjs",
    "web": "vite",
    "dev": "npm run compose && (node --env-file-if-exists=.env server/index.mjs & vite)",
    "build": "tsc -b && vite build",
    "start": "npm run build && npm run compose && NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test:api": "node server/selftest.mjs",
    "test:rewind": "node server/rewind-test.mjs",
    "test:picks": "node server/picks-test.mjs",
    "test:variety": "node server/variety-test.mjs",
    "build:demo": "VITE_STATIC=1 VITE_BRAND=neutral vite build && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "framer-motion": "11.18.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
