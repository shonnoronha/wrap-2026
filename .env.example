# Copy to .env (gitignored) and fill in. Read by the Wrap server only, never by the app.
# Real data serving API: GET {WRAP_DATA_API_URL}/wrap/{rb_user_id}
WRAP_DATA_API_URL=http://<data-api-host>:<port>
WRAP_DATA_API_TOKEN=
# Rewind API (optional, asked first; covers a subset of users): GET {WRAP_REWIND_API_URL}/rewind/{rb_user_id}
# If it has no row for a user or fails, the server falls back to the data API above.
WRAP_REWIND_API_URL=http://<rewind-api-host>:<port>
WRAP_REWIND_API_TOKEN=
# Optional
# WRAP_DATA_TIMEOUT_MS=5000
# WRAP_DUMMY_MAX_ID=400   # IDs up to this are dummy users; 0 sends every ID to the real API
